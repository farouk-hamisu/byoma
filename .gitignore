# Local environment — never commit real values
.env
.env.*
!.env.example

# Note: env.js is intentionally committed — it holds only public-safe values
# (Supabase URL + anon key, which ship to every browser) so Git-based deploys
# (e.g. Vercel) work with zero extra configuration. The service-role key and
# secrets live only in .env and Supabase, never in env.js.

# Dependencies / tooling
node_modules/
.DS_Store
*.log
