# Supabase project configuration (public-safe values only).
# Copy this file to `.env` for local tooling and to `env.js` values for the browser bundle.
# NEVER put the service-role key, email provider keys, or any other secret in these files —
# those belong exclusively in Supabase Edge Function secrets (see README).

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public origin of this site (used for generated links / docs). Example: https://example.com
APP_ORIGIN=http://localhost:3000
